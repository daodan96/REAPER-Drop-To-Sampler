#include "resource.h"

#ifdef _WIN32
#include <windows.h>
#include "version.h"

IDR_PNG_INSERT  RCDATA "res/sampler_insert.png"
IDR_PNG_REPLACE RCDATA "res/sampler_replace.png"

1 VERSIONINFO
FILEVERSION    DTS_VERSION_MAJOR,DTS_VERSION_MINOR,DTS_VERSION_PATCH,0
PRODUCTVERSION DTS_VERSION_MAJOR,DTS_VERSION_MINOR,DTS_VERSION_PATCH,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0
FILEOS         0x40004L
FILETYPE       0x2L
FILESUBTYPE    0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Drop To Sampler"
            VALUE "FileDescription", "REAPER extension: drop media on TCP/MCP/arrange to insert sampler"
            VALUE "FileVersion", DTS_VERSION_STR
            VALUE "InternalName", "reaper_drop_to_sampler"
            VALUE "OriginalFilename", "reaper_drop_to_sampler-x64.dll"
            VALUE "ProductName", "Drop To Sampler"
            VALUE "ProductVersion", DTS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
#endif

// Preferences page. On macOS this dialog is converted by swell_resgen.pl.
IDD_PREFS DIALOGEX 0, 0, 300, 248
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Sampler:", IDC_LABEL_SAMPLER, 8, 10, 108, 10
    COMBOBOX        IDC_SAMPLER_COMBO, 120, 8, 172, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Rec-arm for new tracks:", IDC_LABEL_RECARM, 8, 28, 108, 10
    COMBOBOX        IDC_RECARM_COMBO, 120, 26, 172, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Show sampler:", IDC_LABEL_SHOW, 8, 46, 108, 10
    COMBOBOX        IDC_SHOW_COMBO, 120, 44, 172, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Add/Replace:", IDC_LABEL_EXISTING, 8, 64, 108, 10
    COMBOBOX        IDC_EXISTING_COMBO, 120, 62, 172, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Modifier:", IDC_LABEL_MOD_REPLACE, 120, 82, 52, 10
    COMBOBOX        IDC_MOD_REPLACE_COMBO, 174, 80, 118, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Multiple media:", IDC_LABEL_MULTI, 8, 100, 108, 10
    COMBOBOX        IDC_MULTI_COMBO, 120, 98, 172, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Modifier:", IDC_LABEL_MOD_PLACE, 120, 118, 52, 10
    COMBOBOX        IDC_MOD_PLACE_COMBO, 174, 116, 118, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Multiple samplers:", IDC_LABEL_MULTISAMP, 8, 136, 108, 10
    COMBOBOX        IDC_MULTISAMP_COMBO, 120, 134, 172, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Modifier:", IDC_LABEL_MOD_LAYERS, 120, 154, 52, 10
    COMBOBOX        IDC_MOD_LAYERS_COMBO, 174, 152, 118, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Drop to Arrange:", IDC_LABEL_ARRANGE, 8, 172, 108, 10
    COMBOBOX        IDC_ARRANGE_COMBO, 120, 170, 172, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Drop to TCP/MCP:", IDC_LABEL_TCP, 8, 190, 108, 10
    COMBOBOX        IDC_TCP_COMBO, 120, 188, 172, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Modifier:", IDC_LABEL_MOD_SURFACE, 120, 208, 52, 10
    COMBOBOX        IDC_MOD_SURFACE_COMBO, 174, 206, 118, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Debug", IDC_DEBUG_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 228, 80, 10
    RTEXT           "", IDC_VERSION_LABEL, 212, 228, 80, 10
END
